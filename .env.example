# Copy to .env and fill in. .env is gitignored; never commit it or paste keys in chat.

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_CLIENT_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# Google Ads API
# Google Cloud project approved for Explorer Access
GOOGLE_ADS_CLOUD_PROJECT_NUMBER=
# Developer tokens were sunset 2026-09-09 (F3); leave empty. Access level belongs to the Cloud project.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only needed when calling through a manager account (F3).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
# Startup Genius (closed client account, not a manager account)
GOOGLE_ADS_STARTUP_GENIUS_ID=

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# GA4 Data API (Google Cloud service account JSON path)
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_UNIQUE_ID=
